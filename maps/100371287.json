{"mapId":100371287,"appId":"1","authorId":313311971306248,"title":"罗生门","cover":"https://assets.box3.fun/content/irpsEo3UfEKbbUuZRRHAVcH-kVzhhIPBm_yz9FfH6G0.jpg","description":"辛丑来岛，甲辰去岛，乙巳又回。一春秋，无相识人，昔人各奔东西，空余百荒。忆昔群人今只剩空躯，心中难免存苦痛。然天时长至无垠，人生仅一世，莫若放牵挂，直赴未来。","notice":"","version":1,"publishedAt":"2025-01-26T19:50:57.054","updateAt":"2025-01-26T19:50:57.054","playHash":"4e035327260f0d2b0b52","onlineCount":0,"playCount":14,"favoritesCount":1,"commentCount":2,"viewCount":55,"likeCount":3,"mediaResourcesHash":["https://assets.box3.fun/content/ek1RTRdmpK4Eh5uB7H01wndCXG73GAPbTjC0X2jHfkc.jpg"],"labels":[{"labelId":3,"labelName":"原创","labelKey":"original"}],"currentReleaseVersion":1,"combType":0,"weight":0,"teamable":false,"_tab":"mapOther"}